{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2025",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "dist",
    "preserveConstEnums" : true,
    "noUncheckedIndexedAccess": true,
    "sourceMap": true,
    "sourceRoot": "./",
    "inlineSources": true
  },
  "include": [
    "src/**/*.ts",
  ]
}